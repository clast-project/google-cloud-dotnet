<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <Version>4.15.0</Version>
    <TargetFrameworks>netstandard2.0;net8.0;net10.0</TargetFrameworks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Description>Recommended Google client library to access the Google Cloud Storage API. It wraps the Google.Apis.Storage.v1 client library, making common operations simpler in client code. Google Cloud Storage stores and retrieves potentially large, immutable data objects.</Description>
    <PackageTags>Storage;Google;Cloud</PackageTags>
    <!-- Clast: pin to C# 12 (the level this code was written for). SDK 10's default 'latest' (C# 14) makes 'field'
         a contextual keyword, which collides with existing 'field' identifiers in UrlSigner.SignedPostPolicy.cs. -->
    <LangVersion>12.0</LangVersion>
  </PropertyGroup>
  <!-- Clast: the net10.0 target is validated for trimming/AOT. -->
  <PropertyGroup Condition="'$(TargetFramework)' == 'net10.0'">
    <IsAotCompatible>true</IsAotCompatible>
  </PropertyGroup>
  <!-- Clast: republished under a Clast.* identity only when -p:Clast=true (default off keeps the original identity so
       the in-repo Google.Cloud.Storage.V1.Tests project builds against the published Google.* stack as before). -->
  <PropertyGroup Condition="'$(Clast)' == 'true'">
    <PackageId>Clast.Google.Cloud.Storage.V1</PackageId>
    <AssemblyName>Clast.Google.Cloud.Storage.V1</AssemblyName>
    <AssemblyOriginatorKeyFile Condition="'$(ClastKeyPath)' != ''">$(ClastKeyPath)</AssemblyOriginatorKeyFile>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="ConfigureAwaitChecker.Analyzer" PrivateAssets="All" />
    <!-- Clast: reference the locally-ported (System.Text.Json) libraries instead of the published Newtonsoft-based packages. -->
    <ProjectReference Include="..\..\..\..\gax-dotnet\Google.Api.Gax.Rest\Google.Api.Gax.Rest.csproj" />
    <ProjectReference Include="..\..\..\..\google-api-dotnet-client\Src\Generated\Google.Apis.Storage.v1\Google.Apis.Storage.v1.csproj" />
  </ItemGroup>
  <!-- Clast: System.Text.Json (replacing Newtonsoft.Json in UrlSigner) is in-box on net8.0/net10.0; supplied by the package on netstandard2.0. -->
  <ItemGroup Condition="'$(TargetFramework)' == 'netstandard2.0'">
    <PackageReference Include="System.Text.Json" />
  </ItemGroup>
  <!-- Clast: NuGet metadata stating this is the Clast republish (placed last to override upstream values). -->
  <PropertyGroup Condition="'$(Clast)' == 'true'">
    <Title>Clast republish of Google.Cloud.Storage.V1</Title>
    <Authors>clast-project</Authors>
    <Company>clast-project</Company>
    <Copyright>Clast republish. Based on Google.Cloud.Storage.V1 (Apache-2.0, Copyright Google LLC).</Copyright>
    <PackageProjectUrl>https://github.com/clast-project/google-cloud-dotnet</PackageProjectUrl>
    <RepositoryUrl>https://github.com/clast-project/google-cloud-dotnet</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <Description>Clast republish of Google.Cloud.Storage.V1: the internal UrlSigner JSON moves to System.Text.Json (Utf8JsonWriter), Newtonsoft.Json is removed, the library is trimming/AOT-compatible, and a net10.0 target is added. Namespaces and public type names are unchanged. Independent republish from the clast-project fork — not an official Google package.</Description>
  </PropertyGroup>
  <ItemGroup Condition="'$(Clast)' == 'true'">
    <None Include="..\..\..\CLAST_NUGET.md" Pack="true" PackagePath="README.md" />
  </ItemGroup>

  <Import Project="Google.Cloud.Storage.V1.csproj.google" Condition="Exists('Google.Cloud.Storage.V1.csproj.google')" />
</Project>